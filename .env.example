# Copy to .env and fill. Never commit .env.
# One file at the repo root drives both the API and the voice module.

# Sarvam (required for voice + extraction + photo OCR)
SARVAM_API_KEY=
SARVAM_API_BASE=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b-conversations

# Voice models — shared by services/api/src/config.py and src/voice/config.py.
# sarvam-m is deprecated; plain sarvam-105b reasons for ~10s, too slow for a call.
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu
SARVAM_LLM_MODEL=sarvam-105b-conversations

# Extract path: llm (Sarvam first, formulary backstop) | auto (formulary first,
# LLM only as rescue) | deterministic (never calls Sarvam)
EXTRACT_MODE=llm

# API
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# sqlite is fine for hackathon; swap later if needed
DATABASE_URL=sqlite:///./data/local/dawa.db

# Voice module -> API. Keep the IP form: "localhost" costs a wasted IPv6
# connect attempt before falling back to IPv4 when the API is down.
DAWA_API_URL=http://127.0.0.1:8000
VOICE_LLM_CLASSIFY=1
VOICE_SPEECH_TIMEOUT=20
VOICE_LLM_TIMEOUT=8

# Cockpit (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo defaults (must match fixtures)
DEMO_PATIENT_LANG=hi-IN
DEMO_CAREGIVER_LANG=en-IN
